# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#00212e"

# Main text color
theme[main_fg]="#eaeee9"

# Title color for boxes
theme[title]="#eaeee9"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c7bfae"

# Background color of selected item in processes box. #1a3743 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a3743 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a3743"

# Foreground color of selected item in processes box. Use #eaeee9 so
# the row text stays readable on the lighter_bg highlight; the previous
# #c7bfae produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#eaeee9"

# Color of inactive/disabled text
theme[inactive_fg]="#5d6267"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #edf1ec caps at #ffffff when the foreground is already pure white, so we
# just bind it to #eaeee9 directly.
theme[graph_text]="#eaeee9"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #1a3743 collapsed to the main fg.
theme[meter_bg]="#1a3743"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #24c4e2 for a distinct accent instead of #edf1ec which capped to white.
theme[proc_misc]="#24c4e2"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#97add0"
theme[mem_box]="#50e2bc"
theme[net_box]="#f5687a"
theme[proc_box]="#c7bfae"

# Box divider line and small boxes line color
theme[div_line]="#5d6267"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#50e2bc"
theme[temp_mid]="#c3feff"
theme[temp_end]="#f5687a"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#24c4e2"
theme[cpu_mid]="#6fbcd8"
theme[cpu_end]="#97add0"

# Mem/Disk free meter
theme[free_start]="#97add0"
theme[free_mid]="#6fbcd8"
theme[free_end]="#24c4e2"

# Mem/Disk cached meter
theme[cached_start]="#6fbcd8"
theme[cached_mid]="#24c4e2"
theme[cached_end]="#97add0"

# Mem/Disk available meter
theme[available_start]="#c3feff"
theme[available_mid]="#f5687a"
theme[available_end]="#f5687a"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#50e2bc"
theme[used_mid]="#24c4e2"
theme[used_end]="#6fbcd8"

# Download graph colors
theme[download_start]="#c3feff"
theme[download_mid]="#f5687a"
theme[download_end]="#f5687a"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#50e2bc"
theme[upload_mid]="#24c4e2"
theme[upload_end]="#6fbcd8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#24c4e2"
theme[process_mid]="#6fbcd8"
theme[process_end]="#97add0"
